# Bind application ports to a private address only (never use 0.0.0.0 on a public host).
# WireGuard interface IP on fg-crw-01:
BIND_ADDRESS=172.20.1.2

# MongoDB on host — containers must use docker bridge IP (not 127.0.0.1).
# Ensure mongod bindIp includes 172.17.0.1 — see docs/Mongo.md
MONGO_URI=mongodb://172.17.0.1:27017


# App image version tag (must match Ansible app_image_tag for local tests).
IMAGE_TAG=1.1.0
