# Managed by Ansible — environment for scheduler workers on failover.
# Names must match config/config.py (CONFIG_SCHEDULER_*).

CONFIG_SCHEDULER_TIMEZONE={{ scheduler_timezone }}
CONFIG_SCHEDULER_MONGODB_HOST={{ scheduler_mongodb_host }}
CONFIG_SCHEDULER_MONGODB_PORT={{ scheduler_mongodb_port }}
CONFIG_SCHEDULER_MONGODB_USER_NAME={{ scheduler_mongodb_user }}
CONFIG_SCHEDULER_MONGODB_PASSWORD={{ scheduler_mongodb_password }}
CONFIG_SCHEDULER_MONGODB_TABLE_NAME={{ scheduler_mongodb_table }}
CONFIG_SCHEDULER_MONGODB_COLLECTION_NAME={{ scheduler_mongodb_collection }}
CONFIG_SCHEDULER_FETCHER_API_URL={{ scheduler_fetcher_api_url }}
CONFIG_SCHEDULER_AUTOMATION_API_URL={{ scheduler_automation_api_url }}
CONFIG_SCHEDULER_BOOTSTRAP_SERVERS={{ scheduler_kafka_bootstrap }}
