services:
  zookeeper:
    image: confluentinc/cp-zookeeper:7.5.0
    restart: always
    environment:
      ZOOKEEPER_CLIENT_PORT: 2181
      ZOOKEEPER_TICK_TIME: 2000
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/{{ app_zookeeper_port }}'"]
      interval: {{ app_healthcheck_interval }}
      timeout: 10s
      retries: 5
      start_period: 60s

  kafka:
    image: confluentinc/cp-kafka:7.5.0
    restart: always
    depends_on:
      zookeeper:
        condition: service_healthy
    ports:
      # Primary host listener (metadata / tools)
      - "127.0.0.1:{{ app_kafka_host_port }}:{{ app_kafka_host_port }}"
      # Scheduler KafkaService() defaults to localhost:9092
      - "127.0.0.1:9092:{{ app_kafka_host_port }}"
    environment:
      KAFKA_BROKER_ID: 1
      KAFKA_ZOOKEEPER_CONNECT: zookeeper:2181
      KAFKA_LISTENER_SECURITY_PROTOCOL_MAP: INTERNAL:PLAINTEXT,HOST:PLAINTEXT
      KAFKA_LISTENERS: INTERNAL://0.0.0.0:9092,HOST://0.0.0.0:{{ app_kafka_host_port }}
      KAFKA_ADVERTISED_LISTENERS: INTERNAL://kafka:9092,HOST://127.0.0.1:{{ app_kafka_host_port }}
      KAFKA_INTER_BROKER_LISTENER_NAME: INTERNAL
      KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR: 1
      KAFKA_TRANSACTION_STATE_LOG_MIN_ISR: 1
      KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR: 1
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/{{ app_kafka_port }}'"]
      interval: {{ app_healthcheck_interval }}
      timeout: 10s
      retries: 5
      start_period: 90s

  session-manager:
    build: ./session_manager
    container_name: session-manager
    restart: always
    ports:
      - "127.0.0.1:{{ app_session_manager_port }}:{{ app_session_manager_port }}"
    environment:
      MONGO_URI: {{ app_mongo_uri }}
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - backend
    healthcheck:
      test:
        - CMD-SHELL
        - python -c "import socket; s=socket.create_connection(('127.0.0.1', {{ app_session_manager_port }}), {{ app_healthcheck_connect_timeout }}); s.close()"
      interval: {{ app_healthcheck_interval }}
      timeout: {{ app_healthcheck_timeout }}
      retries: {{ app_healthcheck_retries }}
      start_period: {{ app_healthcheck_start_period }}

  api:
    build: ./api
    container_name: api
    restart: always
    depends_on:
      session-manager:
        condition: service_healthy
    ports:
      - "127.0.0.1:{{ app_api_port }}:{{ app_api_port }}"
    environment:
      SESSION_MANAGER_URL: http://session-manager:8001
    networks:
      - backend
    healthcheck:
      test:
        - CMD-SHELL
        - python -c "import socket; s=socket.create_connection(('127.0.0.1', {{ app_api_port }}), {{ app_healthcheck_connect_timeout }}); s.close()"
      interval: {{ app_healthcheck_interval }}
      timeout: {{ app_healthcheck_timeout }}
      retries: {{ app_healthcheck_retries }}
      start_period: {{ app_healthcheck_start_period }}

networks:
  backend:
    driver: bridge
